# The rejected Exquisite Dentistry Ads fallback is ignored even if set in Vercel.
NEXT_PUBLIC_GOOGLE_ADS_TAG_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_EVENT=ads_conversion_Submit_lead_form_1

