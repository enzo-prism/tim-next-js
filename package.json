    "minimal:check": "node scripts/check-minimal-design.mjs",
    "quality:all": "npm run typecheck && npm run lint && npm run test && npm run design:check && npm run minimal:check && npm run build",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:verify": "node scripts/check-production-schema.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "release:prod": "bash scripts/release-prod.sh"
  },
