    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "design:lint": "design.md lint DESIGN.md",
